     _securityLogThreat('Discord verified: ' + _discordUsername, 'low');
     dcBtn.textContent = 'VERIFIED ✓';
     dcBtn.style.color = '#00c97a';
     dcBtn.style.borderColor = '#00c97a44';
     setTimeout(() => {
      const p2 = document.getElementById('_01studios_panel');
      if (p2) { p2.innerHTML = renderPanel(); attachEvents(p2); }
     }, 1500);
    }
   }
   window.addEventListener('message', onMsg);
