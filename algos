 return [seg1, seg2, seg3, seg4].filter(Boolean).join('-');

 case 'inverse':
 const inv = ts.split('').reverse().join('');
 return inv + '-' + base;

 case 'hybrid':
 return randAlnum(4) + '-' + randHex(8) + '-' + ts + '-' + randAlnum(4);

 default:
