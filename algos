 XMLHttpRequest.prototype.open = function(method, url, ...rest) {
 this._tUrl = url;
 return _origOpen.apply(this, [method, url, ...rest]);
 };
 XMLHttpRequest.prototype.send = function(...args) {
 if (this._tUrl && this._tUrl.includes('/api/games/towers/action')) {
