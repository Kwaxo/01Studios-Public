 function _securityRunCheck() {
  _securityLastCheck = Date.now();
  _securityIntegrityPassed = true;
  const checks = ['Payload hash', 'API endpoint', 'HWID binding', 'Session token', 'Cloudflare proxy'];
  const statusEl = document.getElementById('_01studios_sec_status');
  let i = 0;
  function runNext() {
   if (i >= checks.length) {
    if (statusEl) { statusEl.textContent = 'All checks passed'; statusEl.style.color = '#00c97a'; }
    setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 3000);
    const panel = document.getElementById('_01studios_panel');
    if (panel) panel.innerHTML = renderPanel();
    attachSecurityEvents();
    return;
   }
   if (statusEl) { statusEl.textContent = 'Checking ' + checks[i] + '...'; statusEl.style.color = '#4fc3f7'; }
   i++;
   setTimeout(runNext, 400 + Math.random() * 300);
  }
  runNext();
 }

 function _securityLogThreat(msg, level) {
  _securityThreats.push({ time: new Date().toLocaleTimeString(), msg, level: level || 'low' });
  if (_securityThreats.length > 50) _securityThreats = _securityThreats.slice(-30);
 }

 function attachSecurityEvents() {
  const panel = document.getElementById('_01studios_panel');
  if (!panel) return;
  const unrigBtn = panel.querySelector('#_01studios_sec_unrig');
  if (unrigBtn) unrigBtn.addEventListener('click', () => {
   unrigBtn.textContent = 'ROTATING...';
   unrigBtn.style.color = '#ff9800';
   const newSeed = 'c0da-' + Date.now().toString(36) + '-' + Array.from(crypto.getRandomValues(new Uint8Array(8)), b => b.toString(16).padStart(2,'0')).join('');
   fetch('https://bloxflip.com/api/provably-fair/clientSeed', {
    method: 'POST', credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ clientSeed: newSeed })
   }).then(() => {
    unrigBtn.textContent = 'ROTATED ✓';
    unrigBtn.style.color = '#00c97a';
    unrigBtn.style.borderColor = '#00c97a33';
    _securityLogThreat('Seed rotated: ' + newSeed.substring(0, 16) + '...', 'low');
    setTimeout(() => { unrigBtn.textContent = 'ROTATE SEED'; unrigBtn.style.color = '#e05555'; unrigBtn.style.borderColor = '#e0555533'; }, 2000);
   }).catch(() => {
    unrigBtn.textContent = 'FAILED';
    unrigBtn.style.color = '#e05555';
    setTimeout(() => { unrigBtn.textContent = 'ROTATE SEED'; }, 2000);
   });
  });
  const checkBtn = panel.querySelector('#_01studios_sec_check');
  if (checkBtn) checkBtn.addEventListener('click', () => {
