 const h2 = hist[i];
 if (h2.row === targetRow && h1.row === targetRow - 1 && Math.abs(h2.ts - h1.ts) < 10000) {
 const actualSafe = h2.result === 'win' ? h2.col : -1;
 if (actualSafe !== -1) {
 const drift = Math.sign(actualSafe - h1.col);
 driftCounts[String(drift)]++;
